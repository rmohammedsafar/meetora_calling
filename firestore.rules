rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection: Any authenticated user can read profiles (needed for contacts & calling).
    // A user can update their own profile and status.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Calls collection
    match /calls/{callId} {
      allow read, write: if request.auth != null;
    }
    
    // Call logs
    match /call_logs/{callId} {
      allow read, write: if request.auth != null;
    }
    
    // Messages
    match /messages/{messageId} {
      allow read, write: if request.auth != null;
    }
  }
}
